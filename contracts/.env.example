DEPLOYER_PRIVATE_KEY=
BACKEND_SIGNER_ADDRESS=
CELO_RPC_URL=https://forno.celo.org
CELO_TESTNET_RPC_URL=https://alfajores-forno.celo-testnet.org
CELOSCAN_API_KEY=

# ── Avalanche C-Chain (43114) ────────────────────────────────
# Public endpoint is fine for a DRY RUN. Set a private RPC before --broadcast:
# public endpoints rate-limit, and a deploy that dies halfway leaves orphan
# contracts you have already paid for.
AVALANCHE_RPC_URL=https://avalanche-c-chain-rpc.publicnode.com
AVALANCHE_TESTNET_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# For --verify on Snowtrace. Verification is what makes the contracts readable
# to a grant reviewer, so do not skip it on the real deploy.
SNOWTRACE_API_KEY=

# Avalanche deployer + relay. SEPARATE from the Celo ones above on purpose:
# one .env serves both chains, so sharing the names would mean filling these in
# clobbers your Celo values. DeployAvalanche.s.sol reads ONLY these and has no
# fallback, so a missing one fails loudly instead of quietly deploying from the
# Celo relay key that holds real G$.
AVALANCHE_DEPLOYER_PRIVATE_KEY=
AVALANCHE_BACKEND_SIGNER_ADDRESS=

# Filled in from DeployAvalanche.s.sol output. Copy them, never retype them.
SCRIP_CONTRACT=
AVALANCHE_ITEMS_CONTRACT=
AVALANCHE_MARKETPLACE_CONTRACT=
AVALANCHE_GAME_RECORD_CONTRACT=

# Avalanche C-Chain id. Reference value for tooling and for anyone reading this
# file; the code does NOT read it. DeployAvalanche.s.sol asserts
# `block.chainid == 43114` as a literal, and services/chain_id.rs and
# editions/avalanche/config.ts hold it as a constant, exactly like Celo's 42220.
# That is on purpose: a chain id is a fixed fact, and a hardcoded assert cannot be
# misconfigured, whereas one read from here could be set wrong and would then
# happily approve a deploy to the wrong chain.
AVALANCHE_CHAIN_ID=43114
