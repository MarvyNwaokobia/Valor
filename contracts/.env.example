DEPLOYER_PRIVATE_KEY=
BACKEND_SIGNER_ADDRESS=
CELO_RPC_URL=https://forno.celo.org
CELO_TESTNET_RPC_URL=https://alfajores-forno.celo-testnet.org
CELOSCAN_API_KEY=

# ── Avalanche C-Chain (43114) ────────────────────────────────
# Public endpoint is fine for a DRY RUN. Set a private RPC before --broadcast:
# public endpoints rate-limit, and a deploy that dies halfway leaves orphan
# contracts you have already paid for.
AVALANCHE_RPC_URL=https://avalanche-c-chain-rpc.publicnode.com
AVALANCHE_TESTNET_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# For --verify on Snowtrace. Verification is what makes the contracts readable
# to a grant reviewer, so do not skip it on the real deploy.
SNOWTRACE_API_KEY=

# Avalanche deployer + relay. SEPARATE from the Celo ones above on purpose:
# one .env serves both chains, so sharing the names would mean filling these in
# clobbers your Celo values. DeployAvalanche.s.sol reads ONLY these and has no
# fallback, so a missing one fails loudly instead of quietly deploying from the
# Celo relay key that holds real G$.
AVALANCHE_DEPLOYER_PRIVATE_KEY=
AVALANCHE_BACKEND_SIGNER_ADDRESS=

# Filled in from DeployAvalanche.s.sol output. Copy them, never retype them.
# For proxies this is the PROXY address, never the implementation.
SCRIP_CONTRACT=
AVALANCHE_ITEMS_CONTRACT=
AVALANCHE_MARKETPLACE_CONTRACT=
AVALANCHE_GAME_RECORD_CONTRACT=
# From DeployValorDuel.s.sol. Until this is set, staked SCRP duels stay switched
# off end to end: the relay reports `can_duel() == false` and the lobby says so
# instead of letting anyone pick a stake it cannot escrow.
AVALANCHE_DUEL_CONTRACT=

# ── The Safe ─────────────────────────────────────────────────
# Gnosis Safe multisig on C-Chain that OWNS every Avalanche contract: upgrade
# authority, minter management, fee changes, revenue withdrawal.
#
# Must NOT be the relay. The relay is a hot key on a server; if it also holds
# upgrade rights over the token and the duel escrow, then every guarantee those
# contracts document is only as good as that one server. Both DeployValorDuel and
# HandOverToSafe refuse to run if this equals the relay, and both require it to be
# a CONTRACT, which catches a mistyped EOA before ownership goes somewhere
# irreversible.
#
# Create at https://app.safe.global (pick Avalanche C-Chain). Paste the address it
# gives you, NOT one of the owner addresses that signs for it.
VALOR_OWNER_SAFE=

# House cut on a decided duel, in basis points. 50 = 0.5%, matching the rate the
# Celo duel handler charges. Optional; DeployValorDuel defaults to 50.
DUEL_HOUSE_CUT_BPS=50

# ── One-off migration keys ───────────────────────────────────
# Key for 0x9283f1987793b99cdd1770678860f548cca383a5, the ORIGINAL Avalanche
# deployer, which still holds 1,125 SCRP of deploy-time test minting (92% of
# supply). Used ONLY by BurnTestScrip.s.sol.
#
# This is deliberately its own variable rather than reusing
# AVALANCHE_DEPLOYER_PRIVATE_KEY, because that name now points at the RELAY
# (0x25496AC7…) after the ownership rotation. Running the burn with the relay key
# would destroy nothing and report success.
#
# Clear this once the burn has run. It is a one-off.
SCRIP_BURN_PRIVATE_KEY=

# Avalanche C-Chain id. Reference value for tooling and for anyone reading this
# file; the code does NOT read it. DeployAvalanche.s.sol asserts
# `block.chainid == 43114` as a literal, and services/chain_id.rs and
# editions/avalanche/config.ts hold it as a constant, exactly like Celo's 42220.
# That is on purpose: a chain id is a fixed fact, and a hardcoded assert cannot be
# misconfigured, whereas one read from here could be set wrong and would then
# happily approve a deploy to the wrong chain.
AVALANCHE_CHAIN_ID=43114
