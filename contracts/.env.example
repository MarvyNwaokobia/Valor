DEPLOYER_PRIVATE_KEY=
BACKEND_SIGNER_ADDRESS=
CELO_RPC_URL=https://forno.celo.org
CELO_TESTNET_RPC_URL=https://alfajores-forno.celo-testnet.org
CELOSCAN_API_KEY=

# ── The Safe ─────────────────────────────────────────────────
# Gnosis Safe multisig that OWNS every Valor contract: upgrade authority, fee
# changes, revenue withdrawal.
#
# Must NOT be the relay. The relay is a hot key on a server; if it also holds
# upgrade rights over the marketplace and the reward pool, then every guarantee
# those contracts document is only as good as that one server.
# HandOverCeloToSafe refuses to run if this equals the relay, and requires it to
# be a CONTRACT, which catches a mistyped EOA before ownership goes somewhere
# irreversible.
#
# Create at https://app.safe.global (pick Celo). Paste the address it gives you,
# NOT one of the owner addresses that signs for it.
#
# CHOOSE THE SIGNERS CAREFULLY. A Safe is only a second factor if its signers are
# independent of the systems it protects. Signers that are also operational keys —
# the backend relay, a deployer key sitting in a .env on a laptop — collapse back
# toward the single-key situation the Safe exists to fix, because whoever gets the
# machines gets the threshold. Prefer hardware wallets, or at minimum keys that
# live nowhere near a server.
VALOR_OWNER_SAFE=
