# ─────────────────────────────────────────────────────────────
# Valor Frontend — Environment Variables
# Copy this file to .env.local and fill in each value.
# NEXT_PUBLIC_* vars are bundled into the client — never put secrets here.
# ─────────────────────────────────────────────────────────────

# ── Sign-in: Magic (email + Google) ──────────────────────────
# Magic owns player identity — it is the only thing that MINTS a Valor wallet.
# Publishable key from the Magic dashboard.
NEXT_PUBLIC_MAGIC_API_KEY=

# ── Connect a wallet: Web3Auth ───────────────────────────────
# Web3Auth is ONLY the bring-your-own-wallet connector. Its social logins are
# hidden on purpose (see src/lib/web3authConfig.ts): they would mint a second
# address for a player who already has a Magic one.
# Client ID from the Web3Auth dashboard, on the Sapphire Mainnet network.
# Leave blank to hide the "Connect a Wallet" button entirely — email and Google
# sign-in keep working without it.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# ── Celo RPC (optional) ──────────────────────────────────────
# Private RPC tried before public forno, which is the fallback either way.
# NEXT_PUBLIC_CELO_RPC_URL=

# ── Backend API ──────────────────────────────────────────────
# Local dev: http://localhost:8080
# Production: the Railway app URL, e.g. https://valor-production.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8080
# WebSocket URL is auto-derived from API_URL (http→ws / https→wss).
# Only override if your WS server lives on a different host.
# NEXT_PUBLIC_WS_URL=

# ── GoodDollar ───────────────────────────────────────────────
# "production" | "staging" — leave as production for mainnet Celo
NEXT_PUBLIC_GOODDOLLAR_ENV=production

# The wallet address you registered on engagement-rewards.vercel.app
# Leave blank until you register — canClaim() will return false otherwise
NEXT_PUBLIC_VALOR_APP_ADDRESS=

# ── Smart Contracts (fill after deployment) ──────────────────
# ValorMarketplace.sol deployed address on Celo mainnet
NEXT_PUBLIC_MARKETPLACE_CONTRACT=
